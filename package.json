{
  "name": "shm-agro",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "ТОО «СХМ Агро» — производство и продажа сельхозтехники",
  "engines": {
    "node": ">=22.9.0"
  },
  "scripts": {
    "init-db": "node --env-file-if-exists=.env server/init-db.js",
    "dev:server": "node --env-file-if-exists=.env --watch server/index.js",
    "dev:client": "vite",
    "start": "node --env-file-if-exists=.env server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "reset-password": "node --env-file-if-exists=.env server/reset-password.js",
    "db:status": "node --env-file-if-exists=.env server/db-cli.js status",
    "db:import": "node --env-file-if-exists=.env server/db-cli.js import",
    "db:export": "node --env-file-if-exists=.env server/db-cli.js export"
  },
  "dependencies": {
    "compression": "^1.7.5",
    "cors": "^2.8.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "mammoth": "^1.12.0",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.19.1",
    "pg": "^8.13.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^5.4.11"
  }
}
