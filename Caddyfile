# Единственная дверь снаружи.
#
# Раньше этот файл включался только профилем `--profile tls`, а обычный
# запуск публиковал сайт напрямую по http — пароль администратора уходил
# по сети открытым текстом. Теперь Caddy стоит впереди всегда, а режим
# выбирается одной переменной в .env:
#
#     SITE_ADDRESS=:80            показ по IP, без шифрования
#     SITE_ADDRESS=shmagro.kz     рабочий режим: сертификат сам, http → https
#
# Во втором случае Caddy получает сертификат Let's Encrypt и продлевает
# его без участия человека. Нужны два условия: домен указывает A-записью
# на этот сервер, порты 80 и 443 открыты в файрволе.

{
	# Почта для Let's Encrypt: туда придёт письмо, если с продлением
	# сертификата возникнет проблема. В режиме :80 не используется.
	email {$EMAIL}
}

{$SITE_ADDRESS} {
	# Сайт живёт в соседнем контейнере, внутри общей сети compose.
	reverse_proxy web:3001 {
		# Сколько ждать ответ приложения. Без этого зависший запрос держит
		# соединение Caddy бесконечно.
		transport http {
			dial_timeout 5s
			response_header_timeout 30s
		}
	}

	# Сжатие: у каталога и списка моделей заметный JSON.
	encode zstd gzip

	# Заголовки безопасности сервер ставит сам (CSP, HSTS, X-Frame-Options).
	# Здесь их не дублируем, чтобы не разъехались две правды.
	# Убираем только то, что Caddy добавляет от себя.
	header {
		-Server
	}

	# ─── Ограничение размера запроса ─────────────────────────────────────
	# Приложение и так ограничивает JSON 64 килобайтами, а загрузку файла
	# восемью мегабайтами. Здесь тот же потолок, но на рубеж раньше: тело
	# в гигабайт отсекается, не дойдя до Node и не заняв его память.
	request_body {
		max_size 10MB
	}

	log {
		output file /data/access.log {
			roll_size 10mb
			roll_keep 5
		}
		# В логи не пишем тела запросов — там персональные данные из заявок.
		format json
	}
}
