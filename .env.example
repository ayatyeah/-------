# Пример настроек окружения для ТОО «СХМ Агро».
#
# Скопируйте этот файл в .env и поменяйте значения:
#   cp .env.example .env
#
# Файл .env в git не попадает (см. .gitignore) — там пароли.
# Переменные читает сам Node (флаг --env-file-if-exists), без библиотек.

# Порт API-сервера. Клиент (vite) проксирует /api сюда.
PORT=3001

# Пароль входа в админку. ОБЯЗАТЕЛЬНО задайте свой перед публикацией.
# Пока он пуст или равен «admin», на проде (NODE_ENV=production) вход в
# админку закрыт: сайт работает, но /api/login отвечает 503. Так публичный
# адрес со стандартным паролем не пускает в панель кого попало.
#
# Это ПЕРВЫЙ пароль. После первого входа заказчик задаёт свой прямо в
# админке («Настройки» → «Пароль админки»), и дальше действует только он:
# в данных хранится scrypt-хэш, а не сам пароль. Переменная ниже остаётся
# как способ восстановления — если пароль забыли, на сервере выполняется
#     docker compose exec web node server/reset-password.js
# и вход снова работает по этому значению.
ADMIN_PASSWORD=

# Секрет для подписи сессий админки. Любая длинная случайная строка.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Если не задан — подпись работает на разовом ключе и сессии слетают при каждом
# перезапуске (после деплоя вход заново). Задайте, чтобы сессии жили.
JWT_SECRET=

# Сколько часов живёт сессия админки после входа. По умолчанию 12.
# SESSION_TTL_HOURS=12

# Кому разрешены запросы к API.
# В разработке — адрес vite. На проде укажите домен сайта, например https://shmagro.kz
# Звёздочка (*) открывает API всем — так только для локальной разработки.
CORS_ORIGIN=http://localhost:5173

# Где лежат данные сайта. Базы данных сейчас нет — всё в одном JSON-файле
# внутри проекта. По умолчанию: data/store.json
# STORE_PATH=./data/store.json

# Абсолютный адрес сайта — для og:image и карточки организации (соцсети не
# показывают превью с относительной картинкой). Задаётся на сборке.
# SITE_URL=https://ваш-домен.kz

# Доверять заголовку X-Forwarded-For (настоящий IP клиента за прокси).
# Включать ТОЛЬКО когда перед сайтом реально стоит прокси (в Docker это Caddy,
# и там переменную ставит docker compose). При прямом запуске НЕ включать:
# иначе любой подделает заголовок и обойдёт лимиты частоты.
# TRUST_PROXY=1

# --- Адрес сайта и шифрование ------------------------------------------------
# Главная переменная развёртывания. Определяет, как сайт виден снаружи.
#
#   SITE_ADDRESS=:80          показ по IP, БЕЗ шифрования.
#                             Годится только чтобы показать работу заказчику:
#                             пароль админки идёт по сети открытым текстом.
#
#   SITE_ADDRESS=shmagro.kz   рабочий режим. Caddy сам получит сертификат
#                             Let's Encrypt и будет его продлевать. Нужно,
#                             чтобы домен A-записью указывал на этот сервер,
#                             а порты 80 и 443 были открыты.
SITE_ADDRESS=:80

# Почта для Let's Encrypt: туда придёт письмо, если продление сертификата
# сорвётся. В режиме :80 не используется.
EMAIL=

# --- Загруженные фотографии ---------------------------------------------------
# Куда складывать снимки, загруженные через админку. В Docker это каталог на
# том же томе, что и данные, — значение подставляет docker compose.
# Внутрь dist/ или public/ класть нельзя: они пересоздаются при каждой
# сборке, и все фотографии заказчика исчезли бы после первого же деплоя.
# UPLOAD_DIR=./data/uploads

# Сколько всего мегабайт разрешено занять фотографиям. Когда место
# заканчивается, админка отказывает в загрузке с понятным сообщением.
# Ограничение не косметическое: заполненный диск останавливает запись
# данных, то есть приём заявок.
# UPLOAD_QUOTA_MB=512

# --- Нагрузка и устойчивость --------------------------------------------------
# Общий потолок запросов к API с одного адреса в минуту. Живой посетитель
# столько не набирает даже активно листая каталог; автоматический обстрел
# упирается сразу.
# RATE_LIMIT_GLOBAL=300

# Сколько всего обращений к ИИ разрешено в сутки на весь сайт. Чат открыт
# всем, и каждый ответ стоит денег; лимит по адресу от распределённого
# спама не спасает. Когда лимит исчерпан, чат продолжает отвечать по
# правилам — сайт не ломается, счёт не растёт.
# AI_DAILY_LIMIT=500

# Потолок памяти Node и порог предупреждения в логе. На VPS с 1–2 ГБ без
# них процесс убивает OOM-killer, и в логах не остаётся следов — снаружи
# это выглядит как случайное падение сайта. Значения подставляет compose.
# NODE_HEAP_MB=320
# HEAP_WARN_MB=260

# Ограничения контейнера (используются в docker-compose.yml).
# WEB_MEM_LIMIT=512m
# WEB_CPUS=1.0

# --- Резервные копии ----------------------------------------------------------
# Сколько дней хранить копии данных и как часто их делать (в секундах).
# Архивы фотографий хранятся втрое дольше: их мало, а потеря снимков
# необратима — заново их никто не сфотографирует.
# BACKUP_KEEP_DAYS=14
# BACKUP_EVERY=86400

# --- Уведомления о заявках --------------------------------------------------
# Заявка сохраняется в базе всегда. Если заданы обе переменные — о новой
# заявке ещё и прилетает сообщение в Telegram, чтобы не открывать админку.
# Как получить:
#   1. Напишите @BotFather, команда /newbot — получите TELEGRAM_BOT_TOKEN.
#   2. Напишите своему боту любое сообщение.
#   3. Откройте https://api.telegram.org/bot<ТОКЕН>/getUpdates — в ответе
#      найдите "chat":{"id":...} — это TELEGRAM_CHAT_ID.
# В Telegram уходит только сигнал о заявке; сами данные остаются в базе в РК.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- ИИ ---------------------------------------------------------------------
# Работают анализатор лидов в админке и чат-ассистент на главной.
# Порядок такой: OpenAI -> Gemini -> правила.
# Без ключей сайт полностью работает на правилах — ничего не сломается.
# Библиотек ставить не нужно: запросы идут обычным fetch.

# Порядок провайдеров. Первый, у кого есть ключ и кто ответил, тот и отвечает.
# Поменять местами можно прямо здесь, без правки кода:
#   AI_ORDER=gemini,openai
# AI_ORDER=openai,gemini

# OpenAI — основной.
# Внимание: gpt-5-mini — reasoning-модель, часть токенов уходит на
# внутренние рассуждения. При маленьком лимите ответ приходит ПУСТОЙ,
# поэтому в коде лимиты заведомо щедрые. Отвечает медленнее Gemini.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Gemini — резерв, включается когда OpenAI не ответил.
# Ключей можно указать до трёх: если один упёрся в лимит (429), сервер сам
# возьмёт следующий.
GEMINI_API_KEY=
# GEMINI_API_KEY_2=
# GEMINI_API_KEY_3=
GEMINI_MODEL=gemini-2.5-flash
